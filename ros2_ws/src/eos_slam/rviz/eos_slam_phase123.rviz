Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RGB Input
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /eos/input/rgb
      Transport: raw

    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Depth Colormap
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /eos/debug/depth_colormap
      Transport: raw

    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Features
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /eos/features/image
      Transport: raw

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: 3D Features
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /eos/features/points_3d
      Size (m): 0.02
      Color: 255; 255; 0

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Odom Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /eos/odom/path
      Color: 0; 170; 255
      Line Width: 0.03

    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: VO Matches
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /eos/vo/debug_matches
      Transport: raw

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: VO Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /eos/vo/path
      Color: 255; 0; 0
      Line Width: 0.03

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiDAR Front Filtered
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /eos/lidar/front_filtered
      Size (m): 0.05
      Color: 0; 255; 0

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiDAR Back Filtered
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /eos/lidar/back_filtered
      Size (m): 0.05
      Color: 0; 255; 128

    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Map Cloud
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /eos/map/pointcloud
      Size (m): 0.04
      Color: 255; 200; 50

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Loop-Corrected Path
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /eos/loop_closure/path
      Color: 255; 128; 0
      Line Width: 0.04

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Occupancy Grid
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /eos/map/grid
      Alpha: 0.7
      Color Scheme: map

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10.0
      Name: Current View
      Pitch: 0.5
      Target Frame: map
      Yaw: 0.8
